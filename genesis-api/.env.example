# Genesis API Environment Variables
# Copy this file to .env.local for local development
# Add these variables to your Vercel project settings for production

# Google Sheets Configuration
# 1. Create a Google Sheet with columns: Email | Timestamp | Source | UTM Source | UTM Medium | UTM Campaign | Status
# 2. Copy the Sheet ID from the URL: https://docs.google.com/spreadsheets/d/[SHEET_ID]/edit
GOOGLE_SHEETS_ID=your-google-sheet-id

# Google Service Account
# 1. Go to Google Cloud Console (console.cloud.google.com)
# 2. Create a new project or select existing
# 3. Enable the Google Sheets API
# 4. Go to IAM & Admin > Service Accounts
# 5. Create a new service account
# 6. Create a key (JSON format)
# 7. Stringify the JSON and paste here (or use Vercel's multi-line support)
# 8. Share your Google Sheet with the service account email (Editor access)
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Resend Configuration
# 1. Create account at resend.com
# 2. Add and verify your domain (genesisu.co)
# 3. Get API key from dashboard
RESEND_API_KEY=re_xxxxxxxxxx

# Email sender address (must be from verified domain)
EMAIL_FROM=Genesis <hello@genesisu.co>

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=https://genesisu.co,http://localhost:8000,http://127.0.0.1:8000
